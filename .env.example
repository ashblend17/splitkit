# Copy to .env and adjust. docker-compose reads it automatically.
POSTGRES_PASSWORD=splitkit
JWT_SECRET=dev-only-insecure-secret-change-me-please
# Host ports (5433 so it doesn't collide with a local Postgres on 5432)
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080
# Server only (docker-compose.prod.yml, see deploy.md). There, also set
# COMPOSE_FILE=docker-compose.prod.yml and WEB_PORT=80, and use `openssl rand -hex 32` for
# POSTGRES_PASSWORD and JWT_SECRET (hex, since the password goes into a URL).
IMAGE=<user>/<repo>
