# Copy to .env and fill in; never commit .env. docker compose reads it, and so does the API run
# outside Docker (uvicorn, pytest, alembic, the seed) and tool/build.sh.

# What the app is called on screen, and the Android app's id (another id is another app).
APP_NAME=App
APP_ID=com.example.app
# Names the containers, the database volume and the images (keep it once there's data).
COMPOSE_PROJECT_NAME=app

# The database: its name and user are fixed once its volume exists.
DB_NAME=app
DB_USER=app
# `openssl rand -hex 32` for each (hex: the password goes into a URL). PostgreSQL takes
# POSTGRES_PASSWORD only when its volume is made; changing JWT_SECRET signs everyone out.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
# What the accounts `python -m app.seed` makes sign in with (development only).
SEED_PASSWORD=change-me

# Host ports (5433 so it doesn't collide with a local Postgres on 5432)
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080

# Server only (docker-compose.prod.yml, see deploy.md). There, also set
# COMPOSE_FILE=docker-compose.prod.yml and WEB_PORT=80.
IMAGE=<docker-hub-user>/<repo>
