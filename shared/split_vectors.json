{
  "about": "Language-neutral test vectors for the split engine. The Python engine (api/app/modules/splits) and the Dart port must both pass every case. Amounts are minor units (paise). Input values are strings: exact = minor units, percent = percentage, shares = share count, equal = null (only included people are listed). 'shares' lists expected share_minor per user in input order; omitted when the split is invalid.",
  "cases": [
    {"name": "mockup: equal, all four ticked", "method": "equal", "total_minor": 180000,
     "inputs": [["you", null], ["rahul", null], ["aman", null], ["vivek", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"you": 45000, "rahul": 45000, "aman": 45000, "vivek": 45000}}},
    {"name": "mockup: equal, Vivek unticked", "method": "equal", "total_minor": 180000,
     "inputs": [["you", null], ["rahul", null], ["aman", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"you": 60000, "rahul": 60000, "aman": 60000}}},
    {"name": "mockup: equal, nobody ticked", "method": "equal", "total_minor": 180000,
     "inputs": [],
     "expect": {"ok": false, "remaining_minor": 180000, "message": "Pick at least one person"}},

    {"name": "mockup: exact defaults are ₹100 short", "method": "exact", "total_minor": 180000,
     "inputs": [["you", "60000"], ["rahul", "40000"], ["aman", "50000"], ["vivek", "20000"]],
     "expect": {"ok": false, "remaining_minor": 10000, "message": "₹100 still needs to be allocated"}},
    {"name": "exact adds up", "method": "exact", "total_minor": 180000,
     "inputs": [["you", "70000"], ["rahul", "40000"], ["aman", "50000"], ["vivek", "20000"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"you": 70000, "rahul": 40000, "aman": 50000, "vivek": 20000}}},
    {"name": "exact over the total", "method": "exact", "total_minor": 180000,
     "inputs": [["you", "80000"], ["rahul", "40000"], ["aman", "50000"], ["vivek", "20000"]],
     "expect": {"ok": false, "remaining_minor": -10000, "message": "₹100 over the total — reduce someone"}},
    {"name": "exact remaining in paise", "method": "exact", "total_minor": 10000,
     "inputs": [["you", "4950"], ["rahul", "5000"]],
     "expect": {"ok": false, "remaining_minor": 50, "message": "₹0.50 still needs to be allocated"}},
    {"name": "exact uses Indian digit grouping", "method": "exact", "total_minor": 15000000,
     "inputs": [["you", "0"]],
     "expect": {"ok": false, "remaining_minor": 15000000, "message": "₹1,50,000 still needs to be allocated"}},
    {"name": "exact rejects negative amounts", "method": "exact", "total_minor": 10000,
     "inputs": [["you", "15000"], ["rahul", "-5000"]],
     "expect": {"ok": false, "remaining_minor": 0, "message": "Amounts can't be negative"}},
    {"name": "exact keeps zero rows", "method": "exact", "total_minor": 10000,
     "inputs": [["you", "10000"], ["rahul", "0"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"you": 10000, "rahul": 0}}},

    {"name": "mockup: percent defaults 40/30/20/10", "method": "percent", "total_minor": 180000,
     "inputs": [["you", "40"], ["rahul", "30"], ["aman", "20"], ["vivek", "10"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid", "remaining_percent": "0",
                "shares": {"you": 72000, "rahul": 54000, "aman": 36000, "vivek": 18000}}},
    {"name": "percent under 100 shows percent and rupees", "method": "percent", "total_minor": 180000,
     "inputs": [["you", "40"], ["rahul", "30"], ["aman", "20"], ["vivek", "0"]],
     "expect": {"ok": false, "remaining_minor": 18000, "remaining_percent": "10",
                "message": "10% (₹180) still needs to be allocated"}},
    {"name": "percent over 100", "method": "percent", "total_minor": 180000,
     "inputs": [["you", "45"], ["rahul", "30"], ["aman", "20"], ["vivek", "10"]],
     "expect": {"ok": false, "remaining_minor": -9000, "remaining_percent": "-5",
                "message": "5% over the total — reduce someone"}},
    {"name": "percent 33.33 x3 is 0.01% short", "method": "percent", "total_minor": 10000,
     "inputs": [["a", "33.33"], ["b", "33.33"], ["c", "33.33"]],
     "expect": {"ok": false, "remaining_minor": 1, "remaining_percent": "0.01",
                "message": "0.01% (₹0.01) still needs to be allocated"}},
    {"name": "percent 33.33/33.33/33.34", "method": "percent", "total_minor": 10000,
     "inputs": [["a", "33.33"], ["b", "33.33"], ["c", "33.34"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid", "remaining_percent": "0",
                "shares": {"a": 3333, "b": 3333, "c": 3334}}},
    {"name": "percent rounding: 50/50 of one paisa goes to the first person", "method": "percent", "total_minor": 1,
     "inputs": [["a", "50"], ["b", "50"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid", "remaining_percent": "0",
                "shares": {"a": 1, "b": 0}}},
    {"name": "percent rounding: largest remainder wins", "method": "percent", "total_minor": 1001,
     "inputs": [["a", "10"], ["b", "25"], ["c", "65"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid", "remaining_percent": "0",
                "shares": {"a": 100, "b": 250, "c": 651}}},
    {"name": "percent rejects negatives", "method": "percent", "total_minor": 10000,
     "inputs": [["a", "110"], ["b", "-10"]],
     "expect": {"ok": false, "remaining_minor": 0, "remaining_percent": "0",
                "message": "Percentages can't be negative"}},

    {"name": "mockup: shares 2/1/1/1", "method": "shares", "total_minor": 180000,
     "inputs": [["you", "2"], ["rahul", "1"], ["aman", "1"], ["vivek", "1"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"you": 72000, "rahul": 36000, "aman": 36000, "vivek": 36000}}},
    {"name": "shares all zero", "method": "shares", "total_minor": 180000,
     "inputs": [["you", "0"], ["rahul", "0"]],
     "expect": {"ok": false, "remaining_minor": 180000, "message": "₹1,800 still needs to be allocated"}},
    {"name": "shares accept fractions", "method": "shares", "total_minor": 10000,
     "inputs": [["a", "1"], ["b", "1.5"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"a": 4000, "b": 6000}}},
    {"name": "shares with a zero never get a paisa", "method": "shares", "total_minor": 10000,
     "inputs": [["a", "2"], ["b", "0"], ["c", "1"]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"a": 6667, "b": 0, "c": 3333}}},
    {"name": "shares rejects negatives", "method": "shares", "total_minor": 10000,
     "inputs": [["a", "2"], ["b", "-1"]],
     "expect": {"ok": false, "remaining_minor": 10000, "message": "Shares can't be negative"}},

    {"name": "equal rounding: ₹100 three ways", "method": "equal", "total_minor": 10000,
     "inputs": [["a", null], ["b", null], ["c", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"a": 3334, "b": 3333, "c": 3333}}},
    {"name": "equal rounding: ties go by input order", "method": "equal", "total_minor": 10000,
     "inputs": [["c", null], ["b", null], ["a", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"c": 3334, "b": 3333, "a": 3333}}},
    {"name": "equal rounding: ₹11,200 six ways", "method": "equal", "total_minor": 1120000,
     "inputs": [["a", null], ["b", null], ["c", null], ["d", null], ["e", null], ["f", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"a": 186667, "b": 186667, "c": 186667, "d": 186667, "e": 186666, "f": 186666}}},
    {"name": "equal: one paisa three ways", "method": "equal", "total_minor": 1,
     "inputs": [["a", null], ["b", null], ["c", null]],
     "expect": {"ok": true, "remaining_minor": 0, "message": "Split is valid",
                "shares": {"a": 1, "b": 0, "c": 0}}},

    {"name": "zero total is rejected", "method": "equal", "total_minor": 0,
     "inputs": [["a", null]],
     "expect": {"ok": false, "remaining_minor": 0, "message": "Enter an amount above ₹0"}},
    {"name": "negative total is rejected", "method": "exact", "total_minor": -500,
     "inputs": [["a", "-500"]],
     "expect": {"ok": false, "remaining_minor": -500, "message": "Enter an amount above ₹0"}}
  ]
}
